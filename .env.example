# DAEDALUS // OS — environment
#
# Every variable is optional; the app runs with none of them set.
# Copy to `.env.local` (git-ignored) and edit. All are build/dev-time only:
# there is no server and no secret anywhere in this project.

# Skip the ~3s BIOS boot animation. Invaluable while iterating on a window.
# VITE_SKIP_BOOT=true

# Public base path. Set this when serving from a sub-path, e.g. a GitHub Pages
# project site at https://<user>.github.io/DAEDALUS-V.1/
# VITE_BASE_PATH=/DAEDALUS-V.1/

# Extra hostnames the dev server should accept, comma-separated. Needed when
# developing inside a cloud IDE or behind a preview proxy.
# VITE_ALLOWED_HOSTS=my-workspace.example.dev,localhost
